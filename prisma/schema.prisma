// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                    String                  @id @default(cuid())
  name                  String
  slug                  String                  @unique
  address               String?
  phone                 String?
  email                 String?
  users                 User[]
  projects              Project[]
  tickets               Ticket[]
  tasks                 Task[]
  ticketCustomers       TicketCustomer[]
  ticketGroups          TicketGroup[]
  ticketCategories      TicketCategories[]
  ticketStatuses        TicketStatuses[]
  ticketsSubCategories  TicketSubCategories[]
  ticketsAutomations    TicketsAutomations[]
  ticketEscalationRules TicketEscalationRules[]
  policies              Policy[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String
  organizationId  String
  password        String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  tasksAssigned   Task[]        @relation("TaskAssignedTo")
  ticketsAssigned Ticket[]      @relation("UserAssignedTickets")
  ticketGroups    TicketGroup[] @relation("UserTicketGroups")
  
  // Many-to-many relationships
  policies        UserPolicy[]  // Changed from direct relation to join table

  userAccess TicketAccess? @default(NONE)

  refreshToken String? @unique

  isActive    Boolean   @default(true)
  lastLogin   DateTime?
  is_Verified Boolean   @default(false)
  is_deleted  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Policy {
  id             String @id @default(cuid())
  organizationId String
  policyName     String
  description    String?
  
  // Relationships with organization and users/roles
  organization   Organization @relation(fields: [organizationId], references: [id])
  users         UserPolicy[]
  
  // Policy components relationships
  permissions   PolicyPermissionPolicy[]  @relation("policy_permissions")
  policyType    PolicyType   @default(SYSTEM)
  
  // Metadata
  createdBy     String?
  isActive      Boolean      @default(true)
  isDeleted     Boolean      @default(false)
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("policies")
}

model PolicyPermission {
  id          String   @id @default(cuid())
  permissionName String
  policyType  PolicyPermissionType @default(INTERNAL)
  key         PolicyPermissionKeys 
  description String?
  // Permission details
  action      PolicyAction[]
  effect      PolicyEffect @default(ALLOW)
  
  // Relationships
  policies    PolicyPermissionPolicy[] @relation("permission_policies")
  
  // Metadata
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("policy_permissions")
}

// Join table for many-to-many relationship
model PolicyPermissionPolicy {
  policyId           String
  policyPermissionId String
  policy            Policy          @relation("policy_permissions", fields: [policyId], references: [id], onDelete: Cascade)
  permission        PolicyPermission @relation("permission_policies", fields: [policyPermissionId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@id([policyId, policyPermissionId])
  @@map("policy_permission_policies")
}

model TicketCustomer {
  id             String       @id @default(cuid())
  name           String
  email          String
  phone          String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  tickets        Ticket[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Ticket {
  id               String                 @id @default(cuid())
  title            String
  description      String?
  priority         TicketPriority         @default(MEDIUM)
  responseTime     DateTime?
  resolutionTime   DateTime?
  categoryId       String
  category         TicketCategories       @relation(fields: [categoryId], references: [id])
  subCategoryId    String?
  subCategory      TicketSubCategories?   @relation(fields: [subCategoryId], references: [id])
  customerId       String
  customer         TicketCustomer         @relation(fields: [customerId], references: [id])
  statusID         String
  status           TicketStatuses         @relation(fields: [statusID], references: [id])
  organizationId   String
  organization     Organization           @relation(fields: [organizationId], references: [id])
  customFields     Json?
  automationRuleId String?
  automationRule   TicketsAutomations?    @relation(fields: [automationRuleId], references: [id])
  escalationRuleId String?
  escalationRule   TicketEscalationRules? @relation(fields: [escalationRuleId], references: [id])
  assignedgroupId  String?
  assignedGroup    TicketGroup?           @relation("TicketAssignedTo", fields: [assignedgroupId], references: [id])
  assignedToId     String?
  assignedTo       User?                  @relation("UserAssignedTickets", fields: [assignedToId], references: [id])
  comments         TicketComments[]
  attachments      TicketAttachments[]
  escalations      TicketEscalations[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model TicketAttachments {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketComments {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketGroup {
  id              String       @id @default(cuid())
  name            String
  description     String?
  organizationId  String
  assignedUsers   User[]       @relation("UserTicketGroups")
  organization    Organization @relation(fields: [organizationId], references: [id])
  assignedTickets Ticket[]     @relation("TicketAssignedTo")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model TicketsAutomations {
  id             String       @id @default(cuid())
  name           String
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  tickets        Ticket[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model TicketCategories {
  id                  String                  @id @default(cuid())
  name                String
  description         String?
  organizationId      String
  organization        Organization            @relation(fields: [organizationId], references: [id])
  ticketSubCategories TicketSubCategories[]
  tickets             Ticket[]
  escalationRules     TicketEscalationRules[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
}

model TicketSubCategories {
  id               String           @id @default(cuid())
  name             String
  description      String?
  organizationId   String
  ticketCategoryId String
  ticketCategory   TicketCategories @relation(fields: [ticketCategoryId], references: [id])
  organization     Organization     @relation(fields: [organizationId], references: [id])
  tickets          Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketStatuses {
  id             String       @id @default(cuid())
  name           String
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  tickets        Ticket[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model PricingPlan {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Float

  currency     String
  billingCycle String
  maxUsers     Int
  maxProjects  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id             String       @id @default(cuid())
  name           String
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  tasks          Task[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Task {
  id             String        @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus    @default(PENDING)
  dueDate        DateTime?
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id])
  assignedToId   String?
  assignedTo     User?         @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  comments       TaskComment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  createdAt DateTime @default(now())
}

model TicketEscalationRules {
  id               String           @id @default(cuid())
  name             String
  description      String?
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id])
  categoryId       String
  category         TicketCategories @relation(fields: [categoryId], references: [id])
  priority         TicketPriority
  responseTime     Int // in minutes
  resolutionTime   Int // in minutes
  escalationLevels Json 
  tickets          Ticket[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model TicketEscalations {
  id          String    @id @default(cuid())
  ticketId    String
  ticket      Ticket    @relation(fields: [ticketId], references: [id])
  level       Int
  escalatedTo String // User or group ID
  escalatedAt DateTime  @default(now())
  resolvedAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum UserRoleSlug {
  web_super_admin
  account_owner
  admin
  user 
  guest
  super_admin
  project_manager
  developer
}

enum PolicyType {
  SYSTEM
  CUSTOM
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketAccess {
  NONE
  GlOBAL
  GROUPS
  ASSIGNED
}

enum PolicyAction {
  CREATE
  READ
  UPDATE
  DELETE
}

// New join tables for many-to-many relationships
model UserPolicy {
  userId    String
  policyId  String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy    Policy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, policyId])
  @@map("user_policies")
}

enum PolicyPermissionType {
  INTERNAL
  EXTERNAL
}

enum PolicyEffect {
  ALLOW
  DENY
}

enum PolicyPermissionKeys {
  all
  ticket_create
  ticket_read
  ticket_update
  ticket_delete
  ticket_assign
  ticket_comment
  ticket_forms
  ticket_fields
  ticket_statuses
  ticket_priorities
  ticket_categories
  ticket_sub_categories
  ticket_close
  ticket_reopen
  ticket_assign_group
  ticket_escalation
  ticket_attachments
  ticket_comments
  reports
  user_management
  billings
}